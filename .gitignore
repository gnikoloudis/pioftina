# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Test Artifacts
/coverage
/test-results/
/playwright-report/
/blob-report/
/.tempmediaStorage/

# Next.js & Build Outputs
/.next/
/out/
/build/
/dist/
*.tsbuildinfo

# Environment & Secrets (Never commit secrets to GitHub)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent & AI Tooling Internals
.code-graph/
.agents/
.gemini/
.antigravity/
usage.jsonl
*.jsonl.tmp

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.pem

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel Deployment Metadata
.vercel
