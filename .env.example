# ==============================================================================
# 🇬🇷 pioftina.gr — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' and adjust variables as required:
#   cp .env.example .env.local
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Posokanei / e-Katanalotis Public API Endpoint
POSOKANEI_API_URL=https://posokane.gov.gr/api/v1

# Supabase (Optional: for cloud recipe curation & database persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security & Admin Authentication
# Used for HMAC-SHA256 signing of admin tokens (e.g., /admin/tests, recipe curation studio).
# In production, set this to a secure random string with 32+ characters.
ADMIN_SECRET_KEY=dev-secret-pioftina-change-in-production-123456

# Cron Secret for automated search cache prefetching & background tasks
CRON_SECRET=your-random-32-character-secret-key-here
